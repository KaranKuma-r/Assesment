# ==========================================
# AuraHealth AI - Voice Health Screening
# Environment Configuration
# ==========================================

PORT=5000

# Primary low-latency speech-to-text and LLM provider (recommended)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI Configuration (Alternative STT, LLM & TTS)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VOICE=nova

# Sarvam AI (Indian Languages Hindi/Hinglish STT & Bulbul TTS)
SARVAM_API_KEY=
SARVAM_VOICE=anushka

# Optional Providers
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Provider Override (Leave blank for automatic detection based on API keys)
# Options: groq, openai, sarvam, mock
STT_PROVIDER=
LLM_PROVIDER=
TTS_PROVIDER=

# Default Language Mode (auto, en, hi)
DEFAULT_LANGUAGE=auto
